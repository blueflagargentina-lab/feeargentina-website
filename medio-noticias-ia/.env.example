# Copiar a .env y completar antes de correr el pipeline.

# Requerida para el Agente Redactor (SDK de Anthropic).
ANTHROPIC_API_KEY=

# Opcional: modelo a usar (por defecto claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5

# Opcional: timeout en segundos para llamadas al modelo (por defecto 60).
ANTHROPIC_TIMEOUT_SECONDS=60
